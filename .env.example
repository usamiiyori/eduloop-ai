# ローカル開発用。実際の値は絶対にコミットしない（本番は Google Secret Manager から取得）。
cp_this_to=.env

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Google Gen AI（Phase 4で使用。取得手順はdocs/運用マニュアル.md参照）
GOOGLE_GENAI_API_KEY=
GOOGLE_GENAI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=

# 記事化するかどうかのスコア閾値（現場インパクト×速報性×議論の余地、1〜125）。運用しながら調整。
ARTICLE_SCORE_THRESHOLD=27

# アプリ設定
ENV=local
LOG_LEVEL=INFO
HARNESS_MAX_RETRIES=3
LLM_DAILY_COST_LIMIT_USD=5

# L2承認通知（Phase 5で使用。Discord既定、Slackは任意）
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Web承認画面のURL（Phase 5で使用。GitHub Pagesで公開したページのURL）
REVIEW_APP_URL=https://usamiiyori.github.io/eduloop-ai/

# Web記事末尾の導線（Phase 6で使用。未設定の場合はその導線を追記しない）
CONTACT_URL=
NOTE_URL=

# X投稿（Phase 5で使用。未設定時は下書き生成→手動投稿モードで動作）
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_PUBLISH_MODE=draft   # draft(下書き生成→承認→手動投稿) / api(自動投稿)

# 収集層（Phase 2で使用）。robots.txt遵守のためUser-Agentに連絡先を明記する必要がある。
# 例: https://example.com/contact や mailto:you@example.com 。本番運用前に必ず設定すること。
SCRAPER_CONTACT_URL=
